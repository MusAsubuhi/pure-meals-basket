APP_NAME="Pure Meals Basket"
APP_ENV=production
APP_DEBUG=false
APP_URL=https://app.puremealsbasket.co.ke
# Leave empty: truehost-deploy.sh generates it on first run.
APP_KEY=

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=warning

# --- Database: Supabase Postgres, own "pmb" schema, session pooler ---
DB_CONNECTION=pgsql
# Copy the exact host from Supabase > Connect > Session pooler.
DB_HOST=aws-0-eu-west-2.pooler.supabase.com
DB_PORT=5432
DB_DATABASE=postgres
DB_USERNAME=pmb_app.pwzdbuzwblgflpadbfxv
# The password you set for the pmb_app role in Supabase.
DB_PASSWORD=
DB_SCHEMA=pmb
DB_SSLMODE=require

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_SECURE_COOKIE=true
CACHE_STORE=database
QUEUE_CONNECTION=database
FILESYSTEM_DISK=local

# --- First administrator (used once, on the first deploy) ---
ADMIN_NAME="Your Name"
ADMIN_EMAIL=
ADMIN_PASSWORD=

# --- Mail: use a mailbox created in cPanel (Email Accounts) ---
MAIL_MAILER=smtp
MAIL_HOST=
MAIL_PORT=465
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_SCHEME=smtps
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME="${APP_NAME}"

# --- Google sign-in (optional; leave empty to disable) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=${APP_URL}/auth/google/callback

# --- Manual M-Pesa instructions shown to customers at checkout ---
PMB_MPESA_STK_ENABLED=false
PMB_MPESA_INSTRUCTIONS="Pay via M-Pesa to our Till/Paybill number, then PMB will confirm your payment."
